{
  "name": "@soyl/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "SOYL Academy Learning Platform API (Fastify). See README.md and docs/platform/adr/002-auth-better-auth.md.",
  "exports": {
    "./contract/*": "./src/contract/*.ts",
    "./engine/*": "./src/domain/tests/*.ts",
    "./billing/*": "./src/billing/*.ts",
    "./ai/*": "./src/ai/*.ts",
    "./leagues/*": "./src/domain/leagues/*.ts",
    "./coins/*": "./src/domain/coins/*.ts"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "openapi": "tsx scripts/openapi.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "live": "tsx scripts/live.ts",
    "billing": "tsx scripts/billing.ts"
  },
  "dependencies": {
    "@fastify/swagger": "9.9.3",
    "@soyl/ai-core": "*",
    "@soyl/content-pipeline": "*",
    "@soyl/db": "*",
    "@soyl/shared": "*",
    "better-auth": "1.7.18",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "5.11.1",
    "jose": "6.2.15",
    "openid-client": "6.8.9",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "0.28.2",
    "ioredis-mock": "8.13.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
