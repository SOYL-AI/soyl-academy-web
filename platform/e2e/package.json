{
  "name": "@soyl/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Playwright suites: marketing-site regression (visual, route status, Lighthouse) now; platform flows from M1. See docs/platform/REPO_MAP.md section 9.",
  "scripts": {
    "marketing:baseline": "node scripts/marketing.mjs baseline",
    "marketing:regression": "node scripts/marketing.mjs regression",
    "marketing:diff": "node scripts/marketing-diff.mjs",
    "browsers:install": "playwright install chromium",
    "typecheck": "tsc -p tsconfig.json",
    "test:design-system": "playwright test -c tests/platform/design-system/playwright.config.ts",
    "test:platform-web": "node tests/platform/web/run.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "chrome-launcher": "1.2.2",
    "lighthouse": "13.5.0",
    "typescript": "7.0.2"
  }
}
