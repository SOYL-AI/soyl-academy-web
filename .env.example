# SOYL Academy Environment Variables
# Copy this file to .env.local and fill in values

# Site URL (used for SEO, canonical URLs, sitemap)
NEXT_PUBLIC_SITE_URL=https://soylacademy.com

# Resend API Key (for contact form emails)
# Get your key at https://resend.com
RESEND_API_KEY=

# Resend email configuration
RESEND_FROM_EMAIL=noreply@soylacademy.com
RESEND_TO_EMAIL=hello@soylacademy.com

# Sanity CMS (optional — site works without these)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
