# SOYL Academy Environment Variables
# Copy this file to .env.local and fill in values

# Site URL (used for SEO, canonical URLs, sitemap)
NEXT_PUBLIC_SITE_URL=https://www.soylai.com

# Product app ("Sign in" links here). Defaults to the Azure container URL.
NEXT_PUBLIC_APP_URL=

# Show labelled TODO frames for missing screenshots/photos/proof (default true).
# Set to false to hide empty slots entirely, e.g. before launch.
NEXT_PUBLIC_SHOW_CONTENT_TODOS=true

# Development only: preview Future Builders (registration state + Diwali/standard offer) at a given
# day (YYYY-MM-DD, read as noon IST) or timestamp (2026-11-15T23:58:00+05:30). Ignored in production.
COHORT_PREVIEW_DATE=

# Resend API Key (for contact form emails)
# Get your key at https://resend.com
RESEND_API_KEY=

# Resend email configuration
# Note: SOYL does not own soylacademy.com. Use soylai.com / soyl.cloud addresses only.
RESEND_FROM_EMAIL=noreply@soylai.com
RESEND_TO_EMAIL=outreach@soyl.cloud

# Sanity CMS (optional — site works without these)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Razorpay (Future Builders payments). Server-side only: the order API returns the key id to the
# checkout. In production a missing key refuses payment (503); only local dev mocks the order.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret for POST /api/razorpay/webhook (events: payment.captured, order.paid).
RAZORPAY_WEBHOOK_SECRET=

# Future Builders registrations and enquiries are recorded on the platform API (server-side only):
# POST {PLATFORM_API_ORIGIN}/v1/ingest/future-builders/{enrollments,leads}
PLATFORM_API_ORIGIN=
PLATFORM_EDGE_SECRET=
FB_INGEST_KEY=

# Google Sheets (contact and book-a-demo forms only; Future Builders no longer uses it)
GOOGLE_SHEETS_WEBHOOK_URL=

# Platform API only (set on the API app via platform/infra/params, not on the web host): inbox told about
# each new student sign-up (masked address and counts). Empty = off.
SIGNUP_NOTIFY_EMAIL=
